# copy and rename this template to .env (ignored by git)
# --- Postgres (read by the postgres container on first start) ---
POSTGRES_DB=<db>
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<strong-password>

# --- Hue bridge (used by the poller) ---
HUE_BRIDGE_IP=<ip>
HUE_USERNAME=<hue-token>

# --- Connection string for the poller ---
PG_DSN=host=localhost port=5432 dbname=<db> user=<db-user> password=<strong-password>
