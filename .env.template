# Copy to .env and fill in real values. .env is gitignored.
#
# This file is read by BOTH docker compose (env_file:) and the systemd
# poller unit (EnvironmentFile=). Keep every value free of spaces and
# quotes: the two parsers disagree about quoting, and a quoted value that
# works in one will arrive with literal quote characters in the other.

# --- Postgres container, first start only ---
POSTGRES_DB=<db>
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-pw>

# --- Hue bridge ---
HUE_BRIDGE_IP=<hue-ip>
HUE_USERNAME=<hue-token>

# --- Poller's connection, as discrete libpq variables rather than a DSN ---
# psycopg2 picks these up with no DSN argument, so nothing here needs spaces.
HUE_PGHOST=<host>
HUE_PGPORT=<port>
HUE_PGDATABASE=<db>
HUE_PGUSER=<db-user>
HUE_PGPASSWORD=<db-pw>
